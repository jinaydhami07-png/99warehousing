# ═══════════════════════════════════════════════════════════════
#  99Warehousing — PHP API configuration
#  ───────────────────────────────────────────────────────────────
#  SETUP:  cp config/.env.example config/.env    then fill in below.
#
#  ⚠  config/.env must NEVER be committed, and must never be
#     reachable over HTTP. config/.htaccess denies it, but the safest
#     arrangement is to keep this folder outside public_html.
# ═══════════════════════════════════════════════════════════════


# ── APPLICATION ────────────────────────────────────────────────
# development | production
# production turns on the strict configuration checks near the bottom of
# app/Config/Env.php and stops leaking error details to the browser.
APP_ENV=development

# The site's own address. Used to build OAuth callbacks.
APP_URL=http://localhost:8080

LOG_LEVEL=info
LOG_FILE=storage/logs/app.log

# Max JSON request body, in KB. This is a DoS control — keep it small.
# It does not limit file uploads, which are governed by MEDIA_MAX_MB and
# by upload_max_filesize / post_max_size in php.ini.
BODY_LIMIT_KB=100

# Number of reverse proxies in front of this app (Cloudflare, nginx, an
# ALB). 0 = none.
#   ⚠ Never set this above the real number. X-Forwarded-For is
#     client-supplied, and trusting more hops than exist lets anyone spoof
#     their IP and walk straight through the rate limiter.
TRUST_PROXY=0


# ── DATABASE ───────────────────────────────────────────────────
# On cPanel: MySQL Databases → create a database and a user, then grant
# the user ALL PRIVILEGES on it. cPanel prefixes both names with your
# account, e.g. myacct_99wh and myacct_99whuser.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=<your-database-name>
DB_USER=<your-database-user>
DB_PASSWORD=<your-database-password>
DB_CHARSET=utf8mb4

# Optional. Some cPanel hosts only accept a socket connection; if so they
# will tell you the path, commonly /var/lib/mysql/mysql.sock. When set,
# DB_HOST and DB_PORT are ignored.
# DB_SOCKET=/var/lib/mysql/mysql.sock


# ── CORS ───────────────────────────────────────────────────────
# Comma-separated allow-list of browser origins. No trailing slashes.
#
# Normally this can stay narrow: Apache serves the pages and the API from
# the same host, and a same-origin request sends no Origin header at all.
#
# NEVER "*". Credentials are sent with these requests, and a wildcard would
# let any site on the internet act as your signed-in users. The app refuses
# to start with "*" when APP_ENV=production.
CORS_ORIGINS=http://localhost:8080


# ── AUTHENTICATION ─────────────────────────────────────────────
# Generate two DIFFERENT values:
#     php -r "echo bin2hex(random_bytes(48)), PHP_EOL;"
#
# At least 32 characters, enforced in production. Rotating these signs
# everyone out — which is exactly what you want if one is ever exposed.
JWT_ACCESS_SECRET=<paste-a-96-character-hex-string-here>
JWT_REFRESH_SECRET=<paste-a-DIFFERENT-96-character-hex-string-here>

# Seconds. Keep the access token short: it is the window an attacker gets
# from a leaked one. The refresh token lives in an httpOnly cookie.
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# bcrypt work factor. 12 ≈ 250ms per hash on modern hardware — slow enough
# to make offline cracking expensive, fast enough for interactive login.
# Every +1 doubles the cost. Shared hosting is slow; measure before raising.
BCRYPT_COST=12


# ── RATE LIMITING ──────────────────────────────────────────────
RATE_LIMIT_WINDOW_MIN=15

# Requests per window per IP across the whole API.
RATE_LIMIT_MAX=300

# FAILED attempts per window on /auth/login, /auth/register and
# /auth/admin. This is the brute-force control — keep it low.
AUTH_RATE_LIMIT_MAX=10


# ── ADMIN ──────────────────────────────────────────────────────
# The staff passkey, exchanged for an admin session at /auth/admin.
#
# ⚠ NEVER put the real value in this file — this template is committed, so
#   anything written here is published. Put it in config/.env only.
#   Production refuses to start if it is shorter than 12 characters.
ADMIN_PASSKEY=<choose-a-long-random-staff-passkey>


# ── MEDIA ──────────────────────────────────────────────────────
# Uploads live under public/<MEDIA_DIR>/ and are served by Apache directly.
# The directory must be writable by the web user (755 is usually enough on
# cPanel, where PHP runs as your own account).
MEDIA_DIR=uploads

# Widths rendered per upload. The browser picks one out of the srcset, so a
# phone never downloads the 1920px file.
MEDIA_WIDTHS=320,640,1280,1920
MEDIA_WEBP_QUALITY=78

# The cap on the ORIGINAL upload, in MB. The server downscales and
# re-encodes before storing, so a 9 MB phone photo becomes ~150 KB of WebP.
# php.ini's upload_max_filesize and post_max_size must be at least this.
MEDIA_MAX_MB=10
MEDIA_MAX_FILES=12

# Optional CDN or subdomain in front of public/uploads. Stored per image at
# upload time, so changing it later does not rewrite URLs already saved.
# MEDIA_PUBLIC_BASE_URL=https://cdn.99warehousing.com


# ── GOOGLE SIGN-IN (optional) ──────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → Create
# credentials → OAuth client ID → Web application.
#
# Add the callback below to that client's "Authorised redirect URIs". It
# must match exactly — scheme, host, port and path.
#
# Leave these blank and the Google button reports that it is unconfigured
# instead of failing; nothing else changes.
#
# ⚠ Placeholders only. This file is committed; real values go in .env.
# GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=<your-client-secret>
# GOOGLE_CALLBACK_URL=https://99warehousing.com/api/v1/auth/google/callback

# Extra callbacks, comma-separated, for running one build on several hosts.
# The one whose origin matches the incoming request is used. Every entry
# must also be registered with Google.
# GOOGLE_CALLBACK_URLS=http://localhost:8080/api/v1/auth/google/callback
